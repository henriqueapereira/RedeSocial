@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <!-- Ícone de perfil e menu suspenso -->
            <div class="dropdown">
                <button class="btn btn-link dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <!-- Mostrar a imagem do perfil ou um ícone padrão -->
                    @if (IsUserLoggedIn)
                    {
                        @if (string.IsNullOrEmpty(UserProfileImage) || !Uri.IsWellFormedUriString(UserProfileImage, UriKind.Absolute))
                        {
                            <!-- Exibe imagem padrão (ícone ou imagem) -->
                            <img src="images/default-profile.jpg" alt="Imagem de Perfil" class="profile-img" />
                        }
                        else
                        {
                            <!-- Exibe imagem de perfil do usuário -->
                            <img src="@UserProfileImage" alt="Imagem de Perfil" class="profile-img" />
                        }
                    }
                    else
                    {
                        <!-- Exibe ícone padrão de perfil, caso o usuário não esteja logado -->
                        <i class="bi bi-person-circle" style="font-size: 2rem; color: #333;"></i>
                    }
                </button>
                <ul class="dropdown-menu" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" href="#">Ir para o Perfil</a></li>
                    <li><a class="dropdown-item" href="#">Configurações de Conta</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="#" @onclick="Logout">Sair</a></li>
                </ul>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    // Simulação do estado de login
    private bool IsUserLoggedIn = true; // Defina como "false" se o usuário não estiver logado
    private string UserProfileImage = "images/user-profile.jpg"; // Caminho da imagem de perfil do usuário (pode ser vazio ou nulo)
    private string DefaultProfileImage = "images/default-profile.jpg";

    // Redireciona para a página de login caso o usuário não esteja logado
    protected override async Task OnInitializedAsync()
    {
        if (!IsUserLoggedIn)
        {
            Navigation.NavigateTo("/login"); // Redireciona para a página de login
        }
    }

    private void Logout()
    {
        // Lógica de logout, como limpar dados de autenticação
        IsUserLoggedIn = false;
        UserProfileImage = null; // Limpa a imagem ao fazer logout
        Console.WriteLine("Logout executado!");
        // Navigation.NavigateTo("/login");
    }
}
